# Copy to .env and fill in. Never commit .env.

PORT=3001
CORS_ORIGIN=http://localhost:5173

# Prisma + MongoDB requires a replica set.
# Local (docker compose up -d):
DATABASE_URL="mongodb://localhost:27017/patrickjane?replicaSet=rs0&directConnection=true"
# Atlas:
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/patrickjane"
