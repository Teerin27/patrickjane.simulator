# Copy to .env and fill in. Never commit .env.

PORT=3001
CORS_ORIGIN=http://localhost:5173

# PostgreSQL. Local (docker compose up -d):
DATABASE_URL="postgresql://patrickjane:patrickjane@localhost:5432/patrickjane"
# Hosted (Neon, Supabase, RDS, ...):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# LLM. `ollama` talks to a local Ollama server (https://ollama.com); `dummy` needs no model.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Small and fast, for suspect chat. Use a NON-thinking model (a thinking one takes ~30 s per reply):
#   ollama pull qwen3:4b-instruct-2507-q4_K_M
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Bigger and slower, for generating whole cases: any model that follows JSON schemas well
OLLAMA_CASEGEN_MODEL=qwen3.6:latest
LLM_CHAT_TIMEOUT_MS=90000
LLM_CASEGEN_TIMEOUT_MS=1800000
# Thinking switch per task (default | true | false | low | medium | high). `default` lets the model decide.
# Qwen3 Thinking ignores `false` and leaks its reasoning into the reply, so chat keeps the default.
OLLAMA_CHAT_THINK=default
OLLAMA_CASEGEN_THINK=false
